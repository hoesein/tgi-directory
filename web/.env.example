# Backend API (Next.js). Use "/api" for local dev proxy, or full URL in production.
VITE_API_URL=/api

# Optional public directory data mirror for production. By default, both dev
# and production use the checked-out city-data submodule; do not put secrets here.
VITE_DATA_URL=

# Optional Sentry DSN for web error tracking.
VITE_SENTRY_DSN=

# Optional Cloudflare Web Analytics site token. Public beacon identifier only.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
